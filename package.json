{
  "name": "projects-ideas",
  "version": "1.0.0",
  "description": "Collection de mini-projets web pour s'entrainer sur differents frameworks",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright test --reporter=html && playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "SLOW_MO=300 playwright test --headed",
    "test:api": "node -e \"const fs=require('fs');const code=fs.readFileSync('protask/demo-api.js','utf8');eval(code);testApi().then(r=>process.exit(r.failed))\"",
    "preview-report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.2",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "vite": "^8.1.5"
  }
}

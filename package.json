{
  "name": "projects-ideas",
  "version": "1.0.0",
  "description": "Collection de mini-projets web pour s'entrainer sur differents frameworks",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
